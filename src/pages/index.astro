---
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const target=`${base}en/`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content={`0;url=${target}`}><link rel="canonical" href={target}><title>DULAN</title></head><body><a href={target}>Enter DULAN</a></body></html>
